# Copy this file to `.env` (which is gitignored) and fill in your key.
# Only the opt-in LLM strategy reads these; nothing else needs them.
#   cp .env.example .env

# Your OpenRouter API key (https://openrouter.ai → Keys). Tip: set a per-key
# credit limit when you create it so spend is hard-capped no matter what.
OPENROUTER_API_KEY=sk-or-...

# Optional. Defaults to a cheap model if unset (see game/llm_client.py).
# A cheap paid model (pennies for many games):
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# ...or a zero-cost ":free" model (rate-limited; good only for a wiring check):
# OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
